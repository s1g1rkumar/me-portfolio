<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 700" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0e0a19" />
      <stop offset="100%" stop-color="#07050f" />
    </linearGradient>
    <linearGradient id="goldGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
    <linearGradient id="pinkGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ec4899" />
      <stop offset="100%" stop-color="#8b5cf6" />
    </linearGradient>
  </defs>
  
  <rect width="1200" height="700" fill="url(#bg)" />
  
  <!-- Cyber Grid -->
  <g opacity="0.1" stroke="#f59e0b" stroke-width="1">
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" />
    </pattern>
    <rect width="1200" height="700" fill="url(#grid)" />
  </g>

  <!-- Header -->
  <rect x="40" y="30" width="1120" height="50" rx="8" fill="#131124" stroke="#2a2438" />
  <circle cx="70" cy="55" r="7" fill="#ef4444" />
  <circle cx="95" cy="55" r="7" fill="#f59e0b" />
  <circle cx="120" cy="55" r="7" fill="#10b981" />
  <text x="440" y="60" fill="#f59e0b" font-family="monospace" font-size="16" font-weight="bold">RAJENDRA SURYAWANSHI // STOCK MARKET LEARNING HUB</text>
  
  <!-- Video Player Main Window -->
  <rect x="40" y="100" width="760" height="440" rx="8" fill="#18152e" stroke="#f59e0b" stroke-width="1.5" />
  <!-- Play Icon Glow -->
  <circle cx="420" cy="320" r="45" fill="url(#goldGlow)" opacity="0.9" />
  <polygon points="410,300 440,320 410,340" fill="#ffffff" />
  <text x="70" y="140" fill="#ffffff" font-family="sans-serif" font-size="20" font-weight="bold">Module 4: Technical Analysis &amp; Options Trading Mastery</text>
  <text x="70" y="500" fill="#f59e0b" font-family="monospace" font-size="14">LIVE STREAMING HD // 2,400 ACTIVE LEARNERS WATCHING</text>

  <!-- Course Sidebar -->
  <rect x="820" y="100" width="340" height="560" rx="8" fill="#18152e" stroke="#2a2438" />
  <text x="845" y="140" fill="#f8fafc" font-family="sans-serif" font-size="18" font-weight="bold">Course Curriculum</text>
  
  <rect x="845" y="170" width="290" height="60" rx="6" fill="#2a2438" stroke="#f59e0b" stroke-width="1" />
  <text x="865" y="205" fill="#f59e0b" font-family="sans-serif" font-size="14" font-weight="bold">1. Basics of Stock Market (Unlocked)</text>
  
  <rect x="845" y="245" width="290" height="60" rx="6" fill="#2a2438" />
  <text x="865" y="280" fill="#94a3b8" font-family="sans-serif" font-size="14">2. Candlestick Patterns (Unlocked)</text>

  <rect x="845" y="320" width="290" height="60" rx="6" fill="#2a2438" />
  <text x="865" y="355" fill="#94a3b8" font-family="sans-serif" font-size="14">3. Risk Management 101 (Unlocked)</text>

  <rect x="845" y="395" width="290" height="60" rx="6" fill="#2a2438" />
  <text x="865" y="430" fill="#94a3b8" font-family="sans-serif" font-size="14">4. Advanced Futures &amp; Options</text>

  <!-- Bottom Bar -->
  <rect x="40" y="560" width="760" height="100" rx="8" fill="#18152e" stroke="#2a2438" />
  <text x="70" y="600" fill="#94a3b8" font-family="sans-serif" font-size="14">Instant Payment Gateway &amp; Automated Course Enrollment API</text>
  <rect x="70" y="615" width="400" height="15" rx="7" fill="#2a2438" />
  <rect x="70" y="615" width="360" height="15" rx="7" fill="url(#pinkGlow)" />
  <text x="490" y="627" fill="#10b981" font-family="monospace" font-size="13">94% Conversion Rate</text>
</svg>
