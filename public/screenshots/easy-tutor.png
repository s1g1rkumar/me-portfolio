<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 700" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#070d19" />
      <stop offset="100%" stop-color="#040711" />
    </linearGradient>
    <linearGradient id="blueGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f0ff" />
      <stop offset="100%" stop-color="#2563eb" />
    </linearGradient>
    <linearGradient id="greenGlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
  </defs>
  
  <rect width="1200" height="700" fill="url(#bg)" />
  
  <!-- Cyber Grid -->
  <g opacity="0.12" stroke="#00f0ff" stroke-width="1">
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" />
    </pattern>
    <rect width="1200" height="700" fill="url(#grid)" />
  </g>

  <!-- Header -->
  <rect x="40" y="30" width="1120" height="50" rx="8" fill="#0f172a" stroke="#1e293b" />
  <circle cx="70" cy="55" r="7" fill="#ef4444" />
  <circle cx="95" cy="55" r="7" fill="#f59e0b" />
  <circle cx="120" cy="55" r="7" fill="#10b981" />
  <text x="500" y="60" fill="#00f0ff" font-family="monospace" font-size="16" font-weight="bold">EASY TUTOR // INSTITUTE MANAGEMENT PORTAL</text>
  
  <!-- Stat Cards Row -->
  <rect x="40" y="100" width="260" height="120" rx="8" fill="#0f172a" stroke="#00f0ff" stroke-width="1.5" />
  <text x="65" y="135" fill="#94a3b8" font-family="sans-serif" font-size="14">Total Enrolled Students</text>
  <text x="65" y="180" fill="#00f0ff" font-family="sans-serif" font-size="32" font-weight="bold">4,850+</text>

  <rect x="320" y="100" width="260" height="120" rx="8" fill="#0f172a" stroke="#1e293b" />
  <text x="345" y="135" fill="#94a3b8" font-family="sans-serif" font-size="14">Active Faculty Tutors</text>
  <text x="345" y="180" fill="#3b82f6" font-family="sans-serif" font-size="32" font-weight="bold">128</text>

  <rect x="600" y="100" width="260" height="120" rx="8" fill="#0f172a" stroke="#1e293b" />
  <text x="625" y="135" fill="#94a3b8" font-family="sans-serif" font-size="14">REST API Health</text>
  <text x="625" y="180" fill="#10b981" font-family="sans-serif" font-size="32" font-weight="bold">99.98%</text>

  <rect x="880" y="100" width="280" height="120" rx="8" fill="#0f172a" stroke="#1e293b" />
  <text x="905" y="135" fill="#94a3b8" font-family="sans-serif" font-size="14">Role RBAC Status</text>
  <text x="905" y="180" fill="#a855f7" font-family="sans-serif" font-size="28" font-weight="bold">SECURE</text>

  <!-- Main Grid -->
  <rect x="40" y="245" width="700" height="415" rx="8" fill="#0f172a" stroke="#1e293b" />
  <text x="70" y="285" fill="#f8fafc" font-family="sans-serif" font-size="18" font-weight="bold">Course Batch Performance &amp; Attendance</text>
  
  <!-- Bars -->
  <rect x="70" y="320" width="640" height="35" rx="4" fill="#1e293b" />
  <rect x="70" y="320" width="580" height="35" rx="4" fill="url(#blueGlow)" />
  <text x="85" y="343" fill="#ffffff" font-family="sans-serif" font-size="14" font-weight="bold">Advanced React &amp; TypeScript — 92% Attendance</text>

  <rect x="70" y="380" width="640" height="35" rx="4" fill="#1e293b" />
  <rect x="70" y="380" width="520" height="35" rx="4" fill="url(#greenGlow)" />
  <text x="85" y="403" fill="#ffffff" font-family="sans-serif" font-size="14" font-weight="bold">Node.js Microservices Architecture — 84% Attendance</text>

  <rect x="70" y="440" width="640" height="35" rx="4" fill="#1e293b" />
  <rect x="70" y="440" width="600" height="35" rx="4" fill="url(#blueGlow)" />
  <text x="85" y="463" fill="#ffffff" font-family="sans-serif" font-size="14" font-weight="bold">Full Stack Web Engineering — 95% Attendance</text>

  <!-- Right Panel -->
  <rect x="760" y="245" width="400" height="415" rx="8" fill="#0f172a" stroke="#1e293b" />
  <text x="790" y="285" fill="#f8fafc" font-family="sans-serif" font-size="18" font-weight="bold">System Activity Log</text>
  <text x="790" y="330" fill="#00f0ff" font-family="monospace" font-size="13">[AUTH] Admin logged in from 192.168.1.45</text>
  <text x="790" y="365" fill="#94a3b8" font-family="monospace" font-size="13">[DB] Optimized MySQL query on 'tutors'</text>
  <text x="790" y="400" fill="#10b981" font-family="monospace" font-size="13">[API] GET /api/v1/students 200 OK (14ms)</text>
</svg>
